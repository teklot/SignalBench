<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SignalBench.ViewModels"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="SignalBench.Views.SerialDialog"
        x:DataType="vm:SerialDialogViewModel"
        Title="Serial Port Configuration"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="440"
        CanResize="False">

    <Grid RowDefinitions="*, Auto">
        <ScrollViewer Grid.Row="0">
            <Border Padding="20">
                <StackPanel Spacing="16">
                    <!-- CONNECTION -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="CONNECTION" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="0,0,0,4"/>
                        <Grid ColumnDefinitions="180, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="COM PORT" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">
                                <ComboBox Width="180" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"/>
                                <Button Command="{Binding RefreshPortsCommand}" ToolTip.Tip="Refresh Ports" VerticalAlignment="Center">
                                    <mi:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="BAUD RATE" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,4,0,0"
                                      ItemsSource="{Binding AvailableBaudRates}"
                                      SelectedItem="{Binding SelectedBaudRate}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="PARITY" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,4,0,0"
                                      ItemsSource="{Binding ParityOptions}"
                                      SelectedItem="{Binding Parity}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="DATA BITS" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,4,0,0"
                                           Value="{Binding DataBits}" Minimum="5" Maximum="8" Increment="1" FormatString="0"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="STOP BITS" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,4,0,0"
                                      ItemsSource="{Binding StopBitsOptions}"
                                      SelectedItem="{Binding StopBits}"/>
                        </Grid>
                    </StackPanel>

                    <!-- SCHEMA -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="SCHEMA" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="0,0,0,4"/>
                        <Grid ColumnDefinitions="180, *" RowDefinitions="Auto, Auto, Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="PROTOCOL" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,4,0,4"
                                      ItemsSource="{Binding SchemaProtocolOptions}"
                                      SelectedItem="{Binding SchemaProtocol}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SchemaLabel}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBox Width="180"
                                         Text="{Binding LoadedSchemaPath}"
                                         IsReadOnly="True"/>
                                <Button Command="{Binding OpenSchemaCommand}"
                                        ToolTip.Tip="Browse schema file"
                                        VerticalAlignment="Center">
                                    <mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SchemaHelper}" FontSize="10" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Opacity="0.85" Margin="0,2,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding IsSchemaHelperVisible}"/>
                        </Grid>
                    </StackPanel>

                    <!-- DISPLAY -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="DISPLAY" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="0,0,0,4"/>
                        <Grid ColumnDefinitions="180, *" RowDefinitions="Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="ROLLING WINDOW" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock Text="Live data to show" FontSize="10" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Opacity="0.85"/>
                            </StackPanel>
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,4,0,4"
                                           Value="{Binding RollingWindowSeconds}" Minimum="1" Maximum="3600" Increment="1"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" Padding="20,12" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="100" HorizontalContentAlignment="Center"/>
                <Button Content="Connect" Command="{Binding SaveCommand}" Width="100" HorizontalContentAlignment="Center" Classes="accent"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>